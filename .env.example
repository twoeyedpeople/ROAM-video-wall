# roam-video-wall environment.
#
# This app holds no state of its own: the booth (twoeyedpeople/ROAM) owns the films, and
# this is about reaching it. Every secret here is server-side only. The browser holds
# WALL_DISPLAY_TOKEN and nothing else. The NEXT_PUBLIC_ values reach the browser, carry no
# secret, and are baked in at build time (a change needs a rebuild or a dev restart).

# The booth deployment, no trailing slash. /api/booth/wall-feed and /api/booth/wall-film are
# proxied to ${BOOTH_API_URL}/api/*. Production is https://ford-roam.vercel.app.
BOOTH_API_URL=https://ford-roam.vercel.app

# The booth's WALL_ACCESS_TOKEN, the same value set on both projects. Sent server-side as
# x-wall-token and never to the browser. It opens the wall feed and films and nothing else.
WALL_ACCESS_TOKEN=

# What the display must present, as ?token= on the wall URL once (it is then kept in that
# browser and stripped from the address bar). Unset leaves the proxy open locally and REFUSES
# every call on Vercel, because an open proxy on a public URL hands every guest's film to
# anyone who finds it.
WALL_DISPLAY_TOKEN=

# Films completed before this never play. An ISO date-time, e.g. 2026-09-20T08:00:00+10:00,
# so pre-event test runs stay off the wall. The window also starts afresh at local midnight,
# so each event day replays only that day's guests. Unset means midnight today.
NEXT_PUBLIC_WALL_SINCE=

# How often the wall asks the booth for new films and the hidden list, in ms.
NEXT_PUBLIC_WALL_POLL_MS=15000

# Review build. Set to 1 and the loop runs on sample guests and sample films from
# public/assets/wall/dry-run with no booth at all. NEVER set this on the event deployment.
NEXT_PUBLIC_DRY_RUN=
